[general]
static=yes
writeprotect=yes
autofallthrough=yes

[teamora-inbound]
exten => _X!,1,NoOp(Teamora inbound call)
 same => n,Set(CHANNEL(hangup_handler_push)=teamora-cleanup,s,1)
 same => n,Set(TEAMORA_SOURCE=${CHANNEL(pjsip,remote_addr)})
 same => n,Stasis(${ASTERISK_ARI_APPLICATION},inbound,${EXTEN},${TEAMORA_SOURCE})
 same => n,Hangup()
exten => _+X!,1,NoOp(Teamora inbound E.164 call)
 same => n,Set(CHANNEL(hangup_handler_push)=teamora-cleanup,s,1)
 same => n,Set(TEAMORA_SOURCE=${CHANNEL(pjsip,remote_addr)})
 same => n,Stasis(${ASTERISK_ARI_APPLICATION},inbound,${EXTEN},${TEAMORA_SOURCE})
 same => n,Hangup()

[teamora-transfer]
exten => support,1,NoOp(Transfer to Teamora support queue)
 same => n,Queue(teamora-support,t,,,${OPERATOR_QUEUE_TIMEOUT})
 same => n,Goto(teamora-no-operator,s,1)

[teamora-operator]
; Browser endpoints are receive-only. Operator legs are originated by the
; authenticated Voice Gateway through ARI; arbitrary browser dialing is denied.
exten => _X!,1,NoOp(Rejected direct operator endpoint dial)
 same => n,Hangup(21)

[teamora-no-operator]
exten => s,1,Playback(vm-nobodyavail)
 same => n,Hangup()

[teamora-cleanup]
exten => s,1,NoOp(Teamora call cleanup)
 same => n,Return()
